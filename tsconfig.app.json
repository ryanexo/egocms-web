{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "commitlint.config.ts",
    "vite.config.ts",
    "env.d.ts",
    "src/**/*",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "node_modules/tdesign-vue-next/global.d.ts"
  ],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
